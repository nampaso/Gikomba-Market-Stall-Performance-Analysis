# Task 5 Implementation
def check_stock_and_margins(stock_dict):
    """Audits stock inventory for reorder status and computes gross profit margins.

    Args:
        stock_dict (dict): Dictionary containing item stock parameters (qty, reorder, cost, price).

    Returns:
        tuple: (reorder_list, margins_dict)
            - reorder_list (list): Product names at or below reorder levels.
            - margins_dict (dict): Product names mapped to their gross margin percentage.
    """
    reorder_list = []
    margins_dict = {}

    for item, details in stock_dict.items():
        if details["qty"] <= details["reorder"]:
            reorder_list.append(item)
        
        margin_pct = ((details["price"] - details["cost"]) / details["price"]) * 100
        margins_dict[item] = margin_pct

    return reorder_list, margins_dict

